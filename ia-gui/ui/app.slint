import { Sidebar, Page } from "components/sidebar.slint";
import { SearchPage, SearchResultData } from "pages/search.slint";
import { ItemDetailPage, ItemDetailData, FileEntryData } from "pages/item-detail.slint";
import { DownloadsPage, ActiveDownloadData, DownloadHistoryData } from "pages/downloads.slint";
import { ListsPage, ListSummaryData, ListItemData } from "pages/lists.slint";
import { MetadataPage } from "pages/metadata.slint";
import { SettingsPage, SettingsData } from "pages/settings.slint";

export { Page, SearchResultData, ItemDetailData, FileEntryData, ActiveDownloadData, DownloadHistoryData, ListSummaryData, ListItemData, SettingsData }

export component AppWindow inherits Window {
    title: "Internet Archive";
    preferred-width: 1024px;
    preferred-height: 768px;
    min-width: 800px;
    min-height: 600px;

    in-out property <Page> current-page <=> sidebar.current-page;

    // Search state
    in property <[SearchResultData]> search-results: [];
    in property <string> search-status: "";
    in property <bool> search-in-progress: false;

    // Item detail state
    in-out property <bool> showing-item-detail: false;
    in property <ItemDetailData> item-detail;
    in property <[FileEntryData]> item-detail-files: [];
    in property <bool> item-detail-loading: false;

    // Downloads state
    in property <[ActiveDownloadData]> active-downloads: [];
    in property <[DownloadHistoryData]> download-history: [];

    // Lists state
    in property <[ListSummaryData]> lists: [];
    in-out property <string> selected-list-name: "";
    in property <[ListItemData]> selected-list-items: [];

    // Metadata browse state
    in property <ItemDetailData> metadata-item;
    in property <[FileEntryData]> metadata-files: [];
    in property <bool> metadata-loading: false;
    in property <bool> metadata-has-result: false;

    // Settings state
    in-out property <SettingsData> settings;

    callback search-requested(string, string);
    callback search-result-clicked(int);
    callback search-export-requested(/* format */ string);
    callback item-detail-back();
    callback item-detail-download(/* identifier */ string);
    callback item-detail-add-to-list(/* identifier */ string);
    callback downloads-retry-failed();
    callback downloads-clear-history();
    callback lists-create(/* name */ string);
    callback lists-delete(/* name */ string);
    callback lists-select(/* name */ string);
    callback lists-import(/* name */ string);
    callback lists-download(/* name */ string);
    callback lists-export(/* name */ string);
    callback lists-item-clicked(/* identifier */ string);
    callback lists-remove-item(/* list-name */ string, /* identifier */ string);
    callback metadata-fetch-requested(/* identifier */ string);
    callback metadata-download(/* identifier */ string);
    callback metadata-add-to-list(/* identifier */ string);
    callback metadata-save-json(/* identifier */ string, /* json */ string);
    callback settings-save(SettingsData);
    callback settings-reset();

    HorizontalLayout {
        sidebar := Sidebar {}

        Rectangle {
            background: white;
            horizontal-stretch: 1;

            // Main page content (hidden when item detail is shown)
            if !showing-item-detail && current-page == Page.search : SearchPage {
                results: search-results;
                status-text: search-status;
                searching: search-in-progress;
                search-requested(query, backend) => { root.search-requested(query, backend); }
                result-clicked(index) => { root.search-result-clicked(index); }
                export-requested(format) => { root.search-export-requested(format); }
            }
            if !showing-item-detail && current-page == Page.downloads : DownloadsPage {
                active-downloads: root.active-downloads;
                history: root.download-history;
                retry-failed => { root.downloads-retry-failed(); }
                clear-history => { root.downloads-clear-history(); }
            }
            if !showing-item-detail && current-page == Page.lists : ListsPage {
                lists: root.lists;
                selected-list-name: root.selected-list-name;
                selected-list-items: root.selected-list-items;
                create-list(name) => { root.lists-create(name); }
                delete-list(name) => { root.lists-delete(name); }
                select-list(name) => { root.lists-select(name); }
                import-list(name) => { root.lists-import(name); }
                download-list(name) => { root.lists-download(name); }
                export-list(name) => { root.lists-export(name); }
                list-item-clicked(id) => { root.lists-item-clicked(id); }
                remove-item(list-name, id) => { root.lists-remove-item(list-name, id); }
            }
            if !showing-item-detail && current-page == Page.metadata : MetadataPage {
                item: root.metadata-item;
                files: root.metadata-files;
                loading: root.metadata-loading;
                has-result: root.metadata-has-result;
                fetch-requested(id) => { root.metadata-fetch-requested(id); }
                download-clicked(id) => { root.metadata-download(id); }
                add-to-list-clicked(id) => { root.metadata-add-to-list(id); }
                save-json-clicked(id, json) => { root.metadata-save-json(id, json); }
            }
            if !showing-item-detail && current-page == Page.settings : SettingsPage {
                settings <=> root.settings;
                save-settings(s) => { root.settings-save(s); }
                reset-defaults => { root.settings-reset(); }
            }

            // Item detail overlay
            if showing-item-detail : ItemDetailPage {
                item: item-detail;
                files: item-detail-files;
                loading: item-detail-loading;
                back-clicked => {
                    root.showing-item-detail = false;
                    root.item-detail-back();
                }
                download-clicked(id) => { root.item-detail-download(id); }
                add-to-list-clicked(id) => { root.item-detail-add-to-list(id); }
            }
        }
    }
}
