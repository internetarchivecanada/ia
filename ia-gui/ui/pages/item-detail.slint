import { VerticalBox, HorizontalBox, Button, TabWidget } from "std-widgets.slint";

export struct FileEntryData {
    name: string,
    format: string,
    size: string,
    source: string,
}

export struct ItemDetailData {
    identifier: string,
    title: string,
    mediatype: string,
    description: string,
    creator: string,
    date: string,
    collections: string,
    file-count: int,
    total-size: string,
    json-text: string,
}

export component ItemDetailPage inherits Rectangle {
    in property <ItemDetailData> item;
    in property <[FileEntryData]> files: [];
    in property <bool> loading: false;

    callback back-clicked();
    callback download-clicked(/* identifier */ string);
    callback add-to-list-clicked(/* identifier */ string);

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        // Top bar with back button
        HorizontalBox {
            spacing: 8px;
            alignment: start;

            Button {
                text: "\u{2190} Back";
                clicked => { root.back-clicked(); }
            }
        }

        // Header: thumbnail placeholder + title/metadata
        HorizontalBox {
            spacing: 16px;

            // Large thumbnail placeholder
            Rectangle {
                width: 120px;
                height: 120px;
                background: #e5e7eb;
                border-radius: 8px;

                Text {
                    text: "\u{1F4E6}";
                    font-size: 40px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 6px;
                alignment: start;
                horizontal-stretch: 1;

                Text {
                    text: item.title != "" ? item.title : item.identifier;
                    font-size: 22px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: item.identifier;
                    font-size: 13px;
                    color: #6b7280;
                }
                HorizontalLayout {
                    spacing: 16px;

                    Text {
                        text: item.mediatype;
                        font-size: 13px;
                        color: #6b7280;
                    }
                    if item.file-count > 0 : Text {
                        text: item.file-count + " files";
                        font-size: 13px;
                        color: #6b7280;
                    }
                    if item.total-size != "" : Text {
                        text: item.total-size;
                        font-size: 13px;
                        color: #6b7280;
                    }
                }

                // Action buttons
                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        text: "Download";
                        clicked => { root.download-clicked(item.identifier); }
                    }
                    Button {
                        text: "Add to List";
                        clicked => { root.add-to-list-clicked(item.identifier); }
                    }
                }
            }
        }

        // Loading indicator
        if loading : Text {
            text: "Loading metadata...";
            font-size: 14px;
            color: #6b7280;
            horizontal-alignment: center;
        }

        // Tab content area
        if !loading : TabWidget {
            vertical-stretch: 1;

            Tab {
                title: "Details";

                Flickable {
                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        if item.description != "" : VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Description";
                                font-size: 12px;
                                font-weight: 700;
                                color: #6b7280;
                            }
                            Text {
                                text: item.description;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }

                        if item.creator != "" : VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Creator";
                                font-size: 12px;
                                font-weight: 700;
                                color: #6b7280;
                            }
                            Text {
                                text: item.creator;
                                font-size: 14px;
                            }
                        }

                        if item.date != "" : VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Date";
                                font-size: 12px;
                                font-weight: 700;
                                color: #6b7280;
                            }
                            Text {
                                text: item.date;
                                font-size: 14px;
                            }
                        }

                        if item.collections != "" : VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Collections";
                                font-size: 12px;
                                font-weight: 700;
                                color: #6b7280;
                            }
                            Text {
                                text: item.collections;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Files";

                Flickable {
                    VerticalBox {
                        padding: 16px;
                        spacing: 0px;

                        // Column headers
                        HorizontalLayout {
                            padding-bottom: 8px;
                            spacing: 8px;

                            Text {
                                text: "Name";
                                font-size: 12px;
                                font-weight: 700;
                                color: #6b7280;
                                horizontal-stretch: 3;
                            }
                            Text {
                                text: "Format";
                                font-size: 12px;
                                font-weight: 700;
                                color: #6b7280;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "Size";
                                font-size: 12px;
                                font-weight: 700;
                                color: #6b7280;
                                horizontal-stretch: 1;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: "Source";
                                font-size: 12px;
                                font-weight: 700;
                                color: #6b7280;
                                horizontal-stretch: 1;
                            }
                        }

                        // Separator
                        Rectangle {
                            height: 1px;
                            background: #e5e7eb;
                        }

                        // File rows
                        for file in files : Rectangle {
                            height: 32px;

                            HorizontalLayout {
                                spacing: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;

                                Text {
                                    text: file.name;
                                    font-size: 13px;
                                    horizontal-stretch: 3;
                                    overflow: elide;
                                }
                                Text {
                                    text: file.format;
                                    font-size: 13px;
                                    color: #6b7280;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: file.size;
                                    font-size: 13px;
                                    color: #6b7280;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: file.source;
                                    font-size: 13px;
                                    color: #6b7280;
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        if files.length == 0 : Text {
                            text: "No files.";
                            font-size: 14px;
                            color: #6b7280;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            Tab {
                title: "JSON";

                Flickable {
                    VerticalBox {
                        padding: 16px;

                        Text {
                            text: item.json-text != "" ? item.json-text : "No metadata loaded.";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
