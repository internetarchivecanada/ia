import { VerticalBox, HorizontalBox, Button, LineEdit } from "std-widgets.slint";

export struct ListSummaryData {
    name: string,
    item-count: int,
    is-builtin: bool,
}

export struct ListItemData {
    identifier: string,
    title: string,
}

export component ListsPage inherits Rectangle {
    in property <[ListSummaryData]> lists: [];
    in property <string> selected-list-name: "";
    in property <[ListItemData]> selected-list-items: [];

    callback create-list(/* name */ string);
    callback delete-list(/* name */ string);
    callback select-list(/* name */ string);
    callback import-list(/* name */ string);
    callback download-list(/* name */ string);
    callback export-list(/* name */ string);
    callback list-item-clicked(/* identifier */ string);
    callback remove-item(/* list-name */ string, /* identifier */ string);

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "Lists";
            font-size: 22px;
            font-weight: 700;
        }

        // New list creation
        HorizontalBox {
            spacing: 8px;

            new-list-input := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "New list name...";
                accepted => {
                    if self.text != "" {
                        root.create-list(self.text);
                        self.text = "";
                    }
                }
            }

            Button {
                text: "Create List";
                enabled: new-list-input.text != "";
                clicked => {
                    root.create-list(new-list-input.text);
                    new-list-input.text = "";
                }
            }
        }

        // Split layout: list table (top) and selected list items (bottom)
        // List table
        Rectangle {
            vertical-stretch: 1;
            background: #f9fafb;
            border-radius: 8px;

            VerticalBox {
                padding: 16px;
                spacing: 8px;

                // Column headers
                HorizontalLayout {
                    spacing: 8px;
                    padding-bottom: 4px;

                    Text {
                        text: "Name";
                        font-size: 12px;
                        font-weight: 700;
                        color: #6b7280;
                        horizontal-stretch: 3;
                    }
                    Text {
                        text: "Items";
                        font-size: 12px;
                        font-weight: 700;
                        color: #6b7280;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "Actions";
                        font-size: 12px;
                        font-weight: 700;
                        color: #6b7280;
                        horizontal-stretch: 2;
                        horizontal-alignment: right;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #e5e7eb;
                }

                Flickable {
                    vertical-stretch: 1;

                    VerticalBox {
                        spacing: 0px;

                        for list-entry in lists : Rectangle {
                            height: 40px;
                            background: list-entry.name == selected-list-name ? #e0e7ff :
                                        row-touch.has-hover ? #f3f4f6 : transparent;
                            border-radius: 4px;

                            row-touch := TouchArea {
                                clicked => { root.select-list(list-entry.name); }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                padding-left: 8px;
                                padding-right: 8px;

                                Text {
                                    text: list-entry.name;
                                    font-size: 14px;
                                    font-weight: list-entry.name == selected-list-name ? 600 : 400;
                                    horizontal-stretch: 3;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: list-entry.item-count;
                                    font-size: 13px;
                                    color: #6b7280;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    horizontal-stretch: 2;
                                    spacing: 4px;
                                    alignment: end;

                                    Button {
                                        text: "Export";
                                        height: 28px;
                                        clicked => { root.export-list(list-entry.name); }
                                    }
                                    Button {
                                        text: "Download";
                                        height: 28px;
                                        clicked => { root.download-list(list-entry.name); }
                                    }
                                    Button {
                                        text: "Delete";
                                        height: 28px;
                                        enabled: !list-entry.is-builtin;
                                        clicked => { root.delete-list(list-entry.name); }
                                    }
                                }
                            }
                        }

                        if lists.length == 0 : Text {
                            text: "No lists yet. Create one above.";
                            font-size: 14px;
                            color: #6b7280;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // Selected list items panel
        if selected-list-name != "" : Rectangle {
            vertical-stretch: 1;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e5e7eb;

            VerticalBox {
                padding: 16px;
                spacing: 8px;

                HorizontalBox {
                    spacing: 8px;

                    Text {
                        text: selected-list-name;
                        font-size: 16px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Text {
                        text: selected-list-items.length + " items";
                        font-size: 13px;
                        color: #6b7280;
                        vertical-alignment: center;
                    }

                    Button {
                        text: "Import";
                        height: 28px;
                        clicked => { root.import-list(selected-list-name); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #e5e7eb;
                }

                Flickable {
                    vertical-stretch: 1;

                    VerticalBox {
                        spacing: 0px;

                        for item[index] in selected-list-items : Rectangle {
                            height: 36px;
                            background: item-touch.has-hover ? #f3f4f6 : transparent;
                            border-radius: 4px;

                            item-touch := TouchArea {
                                clicked => { root.list-item-clicked(item.identifier); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;

                                Text {
                                    text: item.identifier;
                                    font-size: 14px;
                                    font-weight: 500;
                                    horizontal-stretch: 2;
                                    vertical-alignment: center;
                                    color: #2563eb;
                                }
                                Text {
                                    text: item.title;
                                    font-size: 13px;
                                    color: #6b7280;
                                    horizontal-stretch: 3;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Button {
                                    text: "Remove";
                                    height: 24px;
                                    clicked => { root.remove-item(root.selected-list-name, item.identifier); }
                                }
                            }
                        }

                        if selected-list-items.length == 0 : Text {
                            text: "This list is empty.";
                            font-size: 14px;
                            color: #6b7280;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
