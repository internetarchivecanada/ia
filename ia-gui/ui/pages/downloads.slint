import { VerticalBox, HorizontalBox, Button, TabWidget } from "std-widgets.slint";

export struct ActiveDownloadData {
    identifier: string,
    status: string,
    files-completed: int,
    files-total: int,
    bytes-downloaded: string,
    bytes-total: string,
    progress: float,
}

export struct DownloadHistoryData {
    identifier: string,
    status: string,
    files-count: string,
    size: string,
    date: string,
}

export component DownloadsPage inherits Rectangle {
    in property <[ActiveDownloadData]> active-downloads: [];
    in property <[DownloadHistoryData]> history: [];

    callback retry-failed();
    callback clear-history();

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "Downloads";
            font-size: 22px;
            font-weight: 700;
        }

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: "Active";

                Flickable {
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;

                        for download in active-downloads : Rectangle {
                            height: 72px;
                            background: #f9fafb;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    Text {
                                        text: download.identifier;
                                        font-size: 14px;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: download.status;
                                        font-size: 12px;
                                        color: download.status == "Complete" ? #16a34a :
                                               download.status == "Failed" ? #dc2626 :
                                               download.status == "Downloading" ? #2563eb : #6b7280;
                                    }
                                }

                                // Progress bar
                                Rectangle {
                                    height: 6px;
                                    background: #e5e7eb;
                                    border-radius: 3px;

                                    Rectangle {
                                        height: parent.height;
                                        width: parent.width * download.progress;
                                        background: download.status == "Complete" ? #16a34a :
                                                    download.status == "Failed" ? #dc2626 : #2563eb;
                                        border-radius: 3px;
                                    }
                                }

                                HorizontalLayout {
                                    Text {
                                        text: download.files-completed + "/" + download.files-total + " files";
                                        font-size: 12px;
                                        color: #6b7280;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: download.bytes-downloaded + " / " + download.bytes-total;
                                        font-size: 12px;
                                        color: #6b7280;
                                    }
                                }
                            }
                        }

                        if active-downloads.length == 0 : Text {
                            text: "No active downloads.";
                            font-size: 14px;
                            color: #6b7280;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Tab {
                title: "History";

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;

                    // Action buttons
                    HorizontalBox {
                        spacing: 8px;
                        alignment: end;

                        Button {
                            text: "Retry Failed";
                            enabled: history.length > 0;
                            clicked => { root.retry-failed(); }
                        }
                        Button {
                            text: "Clear History";
                            enabled: history.length > 0;
                            clicked => { root.clear-history(); }
                        }
                    }

                    // Column headers
                    HorizontalLayout {
                        spacing: 8px;
                        padding-bottom: 4px;

                        Text {
                            text: "Identifier";
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7280;
                            horizontal-stretch: 3;
                        }
                        Text {
                            text: "Status";
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7280;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "Files";
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7280;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "Size";
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7280;
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                        }
                        Text {
                            text: "Date";
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7280;
                            horizontal-stretch: 1;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #e5e7eb;
                    }

                    Flickable {
                        vertical-stretch: 1;

                        VerticalBox {
                            spacing: 0px;

                            for entry in history : Rectangle {
                                height: 32px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: entry.identifier;
                                        font-size: 13px;
                                        horizontal-stretch: 3;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: entry.status;
                                        font-size: 13px;
                                        color: entry.status == "success" ? #16a34a : #dc2626;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.files-count;
                                        font-size: 13px;
                                        color: #6b7280;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.size;
                                        font-size: 13px;
                                        color: #6b7280;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: right;
                                    }
                                    Text {
                                        text: entry.date;
                                        font-size: 13px;
                                        color: #6b7280;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            if history.length == 0 : Text {
                                text: "No download history.";
                                font-size: 14px;
                                color: #6b7280;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Downloaded Files";

                VerticalBox {
                    padding: 16px;

                    Text {
                        text: "Browse downloaded files locally.";
                        font-size: 14px;
                        color: #6b7280;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
