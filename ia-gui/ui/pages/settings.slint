import { VerticalBox, HorizontalBox, LineEdit, Button, CheckBox, SpinBox } from "std-widgets.slint";

export struct SettingsData {
    host: string,
    user-agent-suffix: string,
    insecure: bool,
    download-dir: string,
    jobs: int,
    joblog-enabled: bool,
}

export component SettingsPage inherits Rectangle {
    in-out property <SettingsData> settings;

    callback save-settings(SettingsData);
    callback reset-defaults();

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "Settings";
            font-size: 22px;
            font-weight: 700;
        }

        Flickable {
            vertical-stretch: 1;

            VerticalBox {
                spacing: 24px;

                // Connection section
                VerticalBox {
                    spacing: 8px;

                    Text {
                        text: "Connection";
                        font-size: 16px;
                        font-weight: 600;
                    }

                    Rectangle {
                        height: 1px;
                        background: #e5e7eb;
                    }

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Host:";
                            font-size: 14px;
                            width: 150px;
                            vertical-alignment: center;
                        }
                        host-input := LineEdit {
                            horizontal-stretch: 1;
                            text: settings.host;
                            placeholder-text: "archive.org";
                            edited => { settings.host = self.text; }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "User-Agent Suffix:";
                            font-size: 14px;
                            width: 150px;
                            vertical-alignment: center;
                        }
                        ua-input := LineEdit {
                            horizontal-stretch: 1;
                            text: settings.user-agent-suffix;
                            placeholder-text: "Optional suffix";
                            edited => { settings.user-agent-suffix = self.text; }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Allow Insecure:";
                            font-size: 14px;
                            width: 150px;
                            vertical-alignment: center;
                        }
                        insecure-check := CheckBox {
                            checked: settings.insecure;
                            text: "Use HTTP instead of HTTPS";
                            toggled => { settings.insecure = self.checked; }
                        }
                    }
                }

                // Downloads section
                VerticalBox {
                    spacing: 8px;

                    Text {
                        text: "Downloads";
                        font-size: 16px;
                        font-weight: 600;
                    }

                    Rectangle {
                        height: 1px;
                        background: #e5e7eb;
                    }

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Download Directory:";
                            font-size: 14px;
                            width: 150px;
                            vertical-alignment: center;
                        }
                        dir-input := LineEdit {
                            horizontal-stretch: 1;
                            text: settings.download-dir;
                            placeholder-text: "~/Downloads";
                            edited => { settings.download-dir = self.text; }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Concurrent Jobs:";
                            font-size: 14px;
                            width: 150px;
                            vertical-alignment: center;
                        }
                        jobs-spin := SpinBox {
                            value: settings.jobs;
                            minimum: 1;
                            maximum: 20;
                            edited(val) => { settings.jobs = val; }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Job Log:";
                            font-size: 14px;
                            width: 150px;
                            vertical-alignment: center;
                        }
                        joblog-check := CheckBox {
                            checked: settings.joblog-enabled;
                            text: "Enable download job logging";
                            toggled => { settings.joblog-enabled = self.checked; }
                        }
                    }
                }

                // About section
                VerticalBox {
                    spacing: 8px;

                    Text {
                        text: "About";
                        font-size: 16px;
                        font-weight: 600;
                    }

                    Rectangle {
                        height: 1px;
                        background: #e5e7eb;
                    }

                    Text {
                        text: "Internet Archive Desktop v0.2.2";
                        font-size: 14px;
                        color: #6b7280;
                    }
                    Text {
                        text: "Built with Slint and ia-core";
                        font-size: 13px;
                        color: #9ca3af;
                    }
                }
            }
        }

        // Bottom action buttons
        HorizontalBox {
            spacing: 8px;
            alignment: end;

            Button {
                text: "Reset to Defaults";
                clicked => { root.reset-defaults(); }
            }
            Button {
                text: "Save Settings";
                clicked => { root.save-settings(root.settings); }
            }
        }
    }
}
